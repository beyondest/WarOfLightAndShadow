--- !u!114 &1343383532
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1343383530}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u8D44\u6E90\uFF1A\n\u4E0D\u540C\u7C7B\u578B\u7684\u8D44\u6E90\u5728\u4E0D\u540C\u7684\u751F\u6001\u533A\u57DF\u53EF\u4EE5\u627E\u5230\uFF1B\u6240\u6709\u4E00\u9636\u5355\u4F4D\u548C\u4E00\u9636\u5EFA\u7B51\u7684\u6240\u9700\u8D44\u6E90\u904D\u5E03\u5168\u56FE\u3002\u90E8\u5206\u5927\u578B\u8D44\u6E90\u5177\u6709\u518D\u751F\u80FD\u529B\u3002\n\n\u5404\u4E2A\u5355\u4F4D\u7684Buff\u8BF4\u660E\uFF1A\n\u76FE\u5175
    \uFF1A \u9AD8Hp\uFF0C\u4F46\u4E0D\u5177\u5907\u653B\u51FB\u80FD\u529B\n\u5149\u660E\u76FE\u5175\uFF1A
    \u4E3A\u5468\u56F4\u4E00\u5B9A\u8303\u56F4\u5185\u7684\u961F\u53CB\u62B5\u6321\u4E00\u5B9A\u7A0B\u5EA6\u7684\u8303\u56F4\u4F24\u5BB3\uFF0C\u81EA\u5DF1\u548C\u5468\u56F4\u7684\u6240\u6709\u76FE\u5175\u5171\u540C\u627F\u62C5\u8BE5\u6B21\u8303\u56F4\u4F24\u5BB3\u3002\u62B5\u6321\u80FD\u529B\u968F\u9636\u7EA7\u63D0\u5347\u3002\n\u9ED1\u6697\u76FE\u5175\uFF1A
    \u5F3A\u5236\u5632\u8BBD\u4E00\u5B9A\u8303\u56F4\u5185\u7684\u654C\u4EBA\uFF0C\u8BE5\u654C\u4EBA\u653B\u51FB\u81EA\u5DF1\u65F6\u5C06\u53D7\u5230\u53CD\u4F24\uFF0C\u53CD\u4F24\u80FD\u529B\u968F\u9636\u7EA7\u63D0\u5347\n\u80FD\u91CF\u9A91\u5175\uFF1A
    \u9AD8\u79FB\u901F\uFF0C\u4E2D\u7B49\u653B\u51FB\u80FD\u529B\n\u5149\u660E\u9A91\u5175
    \uFF1A \u5F53\u5904\u4E8E\u9ED1\u6697\u4E2D\u65F6\u5C06\u71C3\u70E7\u90E8\u5206\u8840\u91CF\u4E3A\u9644\u8FD1\u961F\u53CB\u63D0\u4F9B\u7167\u660E\uFF0C\u7167\u660E\u80FD\u529B\u968F\u9636\u7EA7\u63D0\u5347\n\u9ED1\u6697\u9A91\u5175
    \uFF1A \u5BF9\u5149\u660E\u4FE1\u6807\u548C\u6C34\u6676\u7684\u653B\u51FB\u9644\u52A0\u4E00\u5B9A\u65F6\u95F4\u7684\u5931\u660E\u6548\u679C\uFF0C\u968F\u9636\u7EA7\u63D0\u5347\n\u5F13\u624B
    \uFF1A \u8FDC\u8DDD\u653B\u51FB\n\u6CD5\u5E08 : \u5206\u7267\u5E08\u548C\u9B54\u5251\u58EB\u4E24\u4E2A\u5175\u79CD\uFF0C\u8303\u56F4\u6CBB\u7597\u548C\u8303\u56F4\u4F24\u5BB3\u3002\n\u91C7\u96C6\u8005
    \uFF1A \u53EF\u4EE5\u5F00\u91C7\u8D44\u6E90\u7684\u5355\u4F4D\uFF0C\u51E0\u4E4E\u4E0D\u5177\u5907\u653B\u51FB\u80FD\u529B\u3002\n\n\u8FDB\u9A7B\u72B6\u6001\u8BF4\u660E\uFF1A
    \n\u5904\u4E8E\u8FDB\u9A7B\u72B6\u6001\u7684\u5355\u4F4D\uFF0C\u5176\u8840\u91CF\u81EA\u7136\u6062\u590D\u901F\u5EA6\u63D0\u5347\uFF1B\u5F53\u6709\u654C\u5BF9\u5355\u4F4D\u8FDB\u5165\u9632\u5FA1\u5854\u89C6\u91CE\u65F6\uFF0C\u5C06\u81EA\u52A8\u534F\u540C\u9632\u5FA1\u5854\u9632\u5FA1\uFF1B
    \u5F53\u76EE\u6807\u539F\u7406\u4E00\u5B9A\u8DDD\u79BB\u540E\u5C06\u56DE\u5F52\u8FDB\u9A7B\u72B6\u6001\u3002\u8FDB\u9A7B\u5355\u4F4D\u4E0D\u53EF\u88AB\u9009\u4E2D\u64CD\u63A7\u3002\u88AB\u5355\u4F4D\u9632\u5FA1\u7684\u9632\u5FA1\u5854\uFF0C\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u6062\u590D\u767E\u5206\u6BD4\u8840\u91CF\u3002\n\n\n\n"
  m_isRightToLeft: 0
