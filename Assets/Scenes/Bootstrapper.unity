  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u76F8\u673A\u79FB\u52A8\uFF1A\nWASD\u6216\u8005\u9F20\u6807\u4E2D\u952E\u62D6\u52A8\uFF0C\u6309\u4E0Bcapslock\u540E\u5F00\u542F\u5C4F\u5E55\u8FB9\u7F18\u79FB\u52A8\uFF1B\u6309\u4E0Bshift\u52A0\u901F\u79FB\u52A8\uFF1B\u901A\u8FC7\u53F3\u4E0B\u89D2\u5C0F\u5730\u56FE\u53EF\u4EE5\u76F4\u63A5\u62D6\u62FD\u89C6\u91CE4\uFF1B\u6309\u4E0BCtrl\u548C\u9F20\u6807\u4E2D\u952E\u9009\u4E2D\u76F8\u673A\uFF1B\u9F20\u6807\u6EDA\u8F6E\u8C03\u6574\u76F8\u673A\u9AD8\u5EA6\uFF1B\n\n\u5355\u4F4D\u63A7\u5236\uFF1A\n\u9F20\u6807\u5DE6\u952E\u67E5\u770B\u76EE\u6807\u4FE1\u606F\u540C\u65F6\u9009\u4E2D\u53CB\u65B9\u5355\u4F4D\uFF1B\u5DE6\u952E\u62D6\u62FD\u9009\u62E9\u591A\u4E2A\u5355\u4F4D\uFF0C\u53CC\u51FB\u5355\u4F4D\u53EF\u4EE5\u9009\u62E9\u6240\u6709\u5C4F\u5E55\u5185\u7684\u540C\u7C7B\u5355\u4F4D\uFF1B\u9009\u4E2D\u5355\u4F4D\u65F6\u53F3\u952E\u654C\u5BF9\u76EE\u6807\u5C06\u547D\u4EE4\u5355\u4F4D\u8FDB\u653B\uFF0C\u53F3\u952E\u5730\u9762\u547D\u4EE4\u5355\u4F4D\u79FB\u52A8\uFF0C\u53F3\u952E\u9632\u5FA1\u5854\u547D\u4EE4\u5355\u4F4D\u8FDB\u9A7B\u9632\u5FA1\u5854\uFF1B\u53F3\u952E\u53CB\u65B9\u5355\u4F4D\u547D\u4EE4\u5355\u4F4D\u6CBB\u7597\uFF1B\n\n\u5EFA\u9020\uFF1A\n\u70B9\u51FB\u53F3\u4E0A\u89D2\u5EFA\u9020\u56FE\u6807\u8FDB\u5165\u5EFA\u7B51\u6A21\u5F0F\uFF0C\u6216\u8005\u6309\u4E0BB\u8FDB\u5165/\u9000\u51FA\u5EFA\u7B51\u6A21\u5F0F\uFF1B\u5EFA\u7B51\u6A21\u5F0F\u65F6\u4E0D\u53EF\u64CD\u63A7\u5355\u4F4D\uFF1B\u6309\u4E0BQ/E\u4EE590\u5EA6\u65CB\u8F6C\u5EFA\u7B51\uFF1BEcs\u5173\u95ED\u9884\u89C8\uFF1B\n\n\u53EC\u5524\uFF1A\n\u70B9\u51FB\u5BF9\u5E94\u804C\u4E1A\u5355\u4F4D\u7684\u53EC\u5524\u5EFA\u7B51\uFF0C\u5728\u4FE1\u606F\u9762\u677F\u4E2D\u901A\u8FC7\u5FEB\u6377\u952E1-3\u53EC\u5524\u76EE\u6807\uFF0C\u6216\u8005\u70B9\u51FB\u4FE1\u606F\u9762\u677F\u4E2D\u7684\u53EC\u5524\u6CD5\u9635\u6253\u5F00\u5355\u4F4D\u8BE6\u7EC6\u53EC\u5524\u9762\u677F\uFF0C\u7136\u540E\u4E00\u6B21\u6027\u9009\u62E9\u751F\u6210\u6570\u91CF\uFF1B\n\n\u8FDB\u9A7B\u5355\u4F4D\u7684\u64CD\u63A7\uFF1A\n\u70B9\u51FB\u9632\u5FA1\u5854\uFF0C\u5982\u679C\u8BE5\u5EFA\u7B51\u6709\u58EB\u5175\u8FDB\u9A7B\uFF0C\u5219\u4FE1\u606F\u9762\u677F\u53F3\u4FA7\u7684\u7A97\u53E3\u4E2D\u4F1A\u6709\u8FDB\u9A7B\u5355\u4F4D\u7684\u56FE\u6807\u548C\u6570\u91CF\u8BF4\u660E\uFF0C\u5355\u51FB\u5BF9\u5E94\u56FE\u6807\u8BA9\u4E00\u4E2A\u8BE5\u5355\u4F4D\u9000\u51FA\uFF1Bshift\u5355\u51FB\u56FE\u6807\u8BA9\u6240\u6709\u8BE5\u7C7B\u5355\u4F4D\u9000\u51FA\uFF1B\n\n\u5347\u7EA7\uFF1A\n\u70B9\u51FB\u5BF9\u5E94\u5EFA\u7B51\uFF0C\u5982\u679C\u8BE5\u5EFA\u7B51\u53EF\u4EE5\u5347\u7EA7\uFF0C\u5728\u4FE1\u606F\u9762\u677F\u53F3\u4FA7\u70B9\u51FB\u5347\u7EA7\u6309\u94AE\u6D88\u8017\u5BF9\u5E94\u8D44\u6E90\u5347\u7EA7\u3002\u53EC\u5524\u95E8\u53EF\u4EE5\u53EC\u5524\u540C\u9636\u6216\u8005\u4F4E\u9636\u7684\u5355\u4F4D\u3002\n\n"
